{
  "manifest_version": 3,
  "name": "AI Input Method - Emoji Picker",
  "version": "1.0.0",
  "description": "A Chrome extension that provides an input method for emojis via the SidePanel UI.",
  "minimum_chrome_version": "114",
  "permissions": [
    "activeTab",
    "sidePanel",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content-script.js"]
    }
  ],
  "side_panel": {
    "default_path": "sidepanel-simple.html"
  },
  "action": {
    "default_title": "Open Emoji Picker"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "host_permissions": [
    "<all_urls>"
  ]
}