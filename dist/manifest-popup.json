{
  "manifest_version": 3,
  "name": "AI Input Method - Emoji Picker",
  "version": "1.0.0",
  "description": "A Chrome extension that provides an emoji picker via popup interface.",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "background": {
    "service_worker": "background-popup.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content-script.js"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Open Emoji Picker"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "host_permissions": [
    "<all_urls>"
  ]
}